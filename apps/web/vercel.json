{
  "framework": "nextjs",
  "installCommand": "cd ../.. && rm -rf node_modules apps/*/node_modules packages/*/node_modules && bun install --frozen-lockfile",
  "buildCommand": "cd ../.. && bun turbo build --filter=@faroway/web",
  "crons": [
    {
      "path": "/api/cron/cleanup",
      "schedule": "0 * * * *"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "main": false,
      "fix/hotel-traveler-context-20261031": false
    }
  }
}
