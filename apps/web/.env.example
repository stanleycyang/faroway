# Next.js Environment Variables
# Copy this to .env.local and fill in your values

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Local next build only. Leave unset for Vercel and any build that must fail
# if blog collection cannot reach Supabase. Set to 1 solely when an empty
# static blog (no posts, categories, or sitemap entries) is an acceptable
# stand-in, for example a placeholder host. A timeout or ECONNRESET on a
# real production build must still fail the build.
# FAROWAY_BUILD_WITHOUT_BLOG_DB=1
# FAROWAY_STAGING_SUPABASE_PROJECT_REF=

# AI Configuration (optional - for itinerary generation)
AI_GATEWAY_API_KEY=your_vercel_ai_gateway_key
# VERCEL_AI_GATEWAY_API_KEY=

# Per-step planning overrides. Leave unset to keep today's request:
# google/gemini-3-flash, thinking level omitted (Gemini 3 Flash defaults to high),
# and no maxOutputTokens. Values are read at call time. Models must stay on google/*.
# PLANNING_MODEL_ORCHESTRATOR=google/gemini-3-flash
# PLANNING_THINKING_ORCHESTRATOR=high
# PLANNING_MAX_OUTPUT_TOKENS_ORCHESTRATOR=
# The same three variables exist for HOTELS, ACTIVITIES, DINING and AGGREGATOR.
# Model comparison uses FAROWAY_STAGING_AI_GATEWAY_KEY and never reads it from argv.

# Itinerary performance tuning (optional; defaults match lib/search/runtime.ts & affiliate clients)
NEXT_PUBLIC_ITINERARY_STREAMING_ENABLED=true
ITINERARY_ORCHESTRATOR_TIMEOUT_MS=30000
ITINERARY_AI_AGENT_TIMEOUT_MS=60000
ITINERARY_AGGREGATOR_TIMEOUT_MS=60000
ITINERARY_VENDOR_TIMEOUT_MS=2000
ITINERARY_VIATOR_TIMEOUT_MS=30000
ITINERARY_GYG_TIMEOUT_MS=15000
TRIPADVISOR_ENRICHMENT_TIMEOUT_MS=3500
TRIPADVISOR_ENRICHMENT_LIMIT=6

# Base URL — used in OG tags, sitemap, and share links. Override for staging.
NEXT_PUBLIC_BASE_URL=https://www.faroway.ai
NEXT_PUBLIC_SITE_URL=https://www.faroway.ai

# Published mobile store listings. Leave blank until each listing is live;
# the web UI will truthfully show private-preview messaging instead.
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=

# Rate limiting — HMAC salt used before identifiers are stored in Supabase.
# Generate at least 32 random characters and keep it server-only.
IP_HASH_SALT=

# Analytics (optional)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Server security & webhook secrets (required for production webhooks/cron)
# CRON_SECRET=
# WORKFLOW_WEBHOOK_SECRET=
# SHARED_REACTIONS_SECRET=
# ALLOWED_ORIGINS=http://localhost:3000

# Product Feature Flags (server-only unless prefixed with NEXT_PUBLIC_)
FAROWAY_BOOKING_CHECKLIST_ENABLED=false
FAROWAY_PLAN_EDITING_ENABLED=false
FAROWAY_PLANNING_PAUSED=false
PUSH_CONSENT_V2_ENABLED=false
PUSH_DELIVERY_ENABLED=false

# Account Deletion (optional)
ACCOUNT_DELETION_ENABLED=false
# APPLE_DELETION_CLIENT_ID=
# APPLE_DELETION_CLIENT_SECRET=
# ACCOUNT_DELETION_ENCRYPTION_KEY=

# ── Travel Vendor & Affiliate Partner Integrations ───────────────────────────

# Viator (Tours & Experiences — commercial approval gates required for live display)
VIATOR_API_KEY=
VIATOR_PARTNER_ID=
VIATOR_MCID=
VIATOR_SANDBOX=false
VIATOR_CONTENT_ENABLED=false
VIATOR_CONTENT_APPROVAL_REF=
VIATOR_EXTERNAL_PROCESSING_ENABLED=false
VIATOR_EXTERNAL_PROCESSING_APPROVAL_REF=
VIATOR_HOSTED_CHECKOUT_ENABLED=false

# GetYourGuide Partner API (activities — 8% commission)
GETYOURGUIDE_API_KEY=
GETYOURGUIDE_PARTNER_ID=

# Duffel (Flights via Duffel Links)
DUFFEL_API_TOKEN=
DUFFEL_SUPPLIER_TIMEOUT_MS=8000
DUFFEL_LINK_TIMEOUT_MS=2500

# TripAdvisor & Tavily Enrichment
TRIPADVISOR_API_KEY=
TAVILY_API_KEY=

# Travelpayouts (Multi-vertical network wrapper for Aviasales, Hotellook, Klook, Tiqets, etc.)
TRAVELPAYOUTS_MARKER=
TRAVELPAYOUTS_TRS=
# Optional program ID overrides:
# TRAVELPAYOUTS_KLOOK_PROGRAM_ID=4110
# TRAVELPAYOUTS_TIQETS_PROGRAM_ID=
# TRAVELPAYOUTS_AVIASALES_PROGRAM_ID=4114
# TRAVELPAYOUTS_HOTELLOOK_PROGRAM_ID=4115
# TRAVELPAYOUTS_DISCOVERCARS_PROGRAM_ID=
# TRAVELPAYOUTS_AIRALO_PROGRAM_ID=
# TRAVELPAYOUTS_SAFETYWING_PROGRAM_ID=
# TRAVELPAYOUTS_SHERPA_PROGRAM_ID=

# Accommodation Affiliate Partners
STAY22_AID=
BOOKING_AFFILIATE_ID=
EXPEDIA_AFFCID=
EXPEDIA_CAMREF=
HOSTELWORLD_AFFILIATE_ID=

# Activities, Dining & Flights Search Affiliate Partners
KLOOK_AFFILIATE_ID=
KLOOK_AD_ID=
OPENTABLE_AFFILIATE_ID=
SKYSCANNER_ASSOCIATE_ID=

# Trip Essentials Affiliate Partners (Insurance, eSIM, Cars, Visas, FX)
SAFETYWING_REFERENCE_ID=
SAFETYWING_AMBASSADOR_ID=
AIRALO_AFFILIATE_ID=
AIRALO_IR_CLICK_ID=
DISCOVERCARS_AFFILIATE_ID=
DISCOVERCARS_BID=
IVISA_AFFILIATE_ID=
IVISA_IR_CLICK_ID=
WISE_AFFILIATE_ID=
WISE_IR_CLICK_ID=

# Affiliate Conversion Webhook Secrets (HMAC-SHA256 verification; fail-closed when unset)
# VIATOR_WEBHOOK_SECRET=
# GYG_WEBHOOK_SECRET=
# KLOOK_WEBHOOK_SECRET=
# TRAVELPAYOUTS_WEBHOOK_SECRET=
# STAY22_WEBHOOK_SECRET=
# DUFFEL_WEBHOOK_SECRET=
# SAFETYWING_WEBHOOK_SECRET=
# AIRALO_WEBHOOK_SECRET=

# Google Places (optional - for Places autocomplete on create page)
# Same key as mobile — only needs Places API enabled
GOOGLE_PLACES_API_KEY=your_google_places_api_key
# Default-off: enable Google live autocomplete/search/details only after billing, restrictions,
# quotas and provider presentation/terms are reviewed. City planning is independent.
GOOGLE_PLACES_LIVE_ENABLED=false
# Optional, user-requested accessibility fields may incur additional Places charges.
GOOGLE_PLACES_ACCESSIBILITY_ENABLED=false

# Error monitoring — Sentry (required for production)
# 1. Create a project at https://sentry.io
# 2. Copy the DSN from Project Settings → Client Keys
# 3. Add SENTRY_AUTH_TOKEN from https://sentry.io/settings/auth-tokens/
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
# Release tagging — set this to the git commit SHA in CI
NEXT_PUBLIC_APP_VERSION=

# Site ownership verification (optional)
# GOOGLE_SITE_VERIFICATION=
# IMPACT_SITE_VERIFICATION=

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional MET Norway weather. Keep disabled until public contact, shared cache
# migration and distributed rate-limit configuration are verified. No API key.
MET_WEATHER_ENABLED=false
# Owner must supply Faroway identification plus a verified public business contact URL.
MET_USER_AGENT=

# Hotel & Flight Migration (LiteAPI) — keep sandbox/live disabled until supplier approval
NEXT_PUBLIC_HOTEL_SEARCH_ENABLED=false
LITEAPI_API_KEY=
LITEAPI_SANDBOX_ENABLED=false
LITEAPI_FLIGHTS_ENABLED=false
LITEAPI_FLIGHTS_PRODUCTION_APPROVED=false
LITEAPI_FLIGHTS_SANDBOX_ENABLED=false
# Reuses LITEAPI_API_KEY; sandbox keys are never accepted by live itinerary search.
