# Next.js Environment Variables
# Copy this to .env.local and fill in your values

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# AI Configuration (optional - for itinerary generation)
OPENAI_API_KEY=your_openai_api_key
GOOGLE_AI_API_KEY=your_google_ai_api_key
AI_GATEWAY_API_KEY=your_vercel_ai_gateway_key

# Itinerary performance tuning (optional)
NEXT_PUBLIC_ITINERARY_STREAMING_ENABLED=true
ITINERARY_ORCHESTRATOR_TIMEOUT_MS=750
ITINERARY_AI_AGENT_TIMEOUT_MS=1500
ITINERARY_AGGREGATOR_TIMEOUT_MS=1000
ITINERARY_VENDOR_TIMEOUT_MS=2000
TRIPADVISOR_ENRICHMENT_TIMEOUT_MS=500
TRIPADVISOR_ENRICHMENT_LIMIT=6

# Base URL — used in OG tags, sitemap, and share links. Override for staging.
NEXT_PUBLIC_BASE_URL=https://www.faroway.ai

# Published mobile store listings. Leave blank until each listing is live;
# the web UI will truthfully show private-preview messaging instead.
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=

# Rate limiting — HMAC salt used before identifiers are stored in Supabase.
# Generate at least 32 random characters and keep it server-only.
IP_HASH_SALT=

# Analytics (optional — if integrated; see P1-4 in PROD_AUDIT.md)
# NEXT_PUBLIC_ANALYTICS_SITE_ID=your_site_id

# Travel vendor APIs (optional - generation falls back gracefully when absent)
VIATOR_API_KEY=
VIATOR_PARTNER_ID=
VIATOR_SANDBOX=false
BOOKING_COM_TOKEN=
BOOKING_COM_AFFILIATE_ID=
BOOKING_COM_ENV=production
BOOKING_COM_BOOKER_COUNTRY=us
# Legacy Distribution XML fallback (optional)
BOOKING_COM_USERNAME=
BOOKING_COM_PASSWORD=
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_ENV=test
DUFFEL_API_TOKEN=
DUFFEL_SUPPLIER_TIMEOUT_MS=2000
DUFFEL_LINK_TIMEOUT_MS=750
TRIPADVISOR_API_KEY=
TAVILY_API_KEY=

# GetYourGuide Partner API (activities — 8% commission)
GETYOURGUIDE_API_KEY=
GETYOURGUIDE_PARTNER_ID=

# Google Places (optional - for Places autocomplete on create page)
# Same key as mobile — only needs Places API enabled
GOOGLE_PLACES_API_KEY=your_google_places_api_key

# Error monitoring — Sentry (required for production)
# 1. Create a project at https://sentry.io
# 2. Copy the DSN from Project Settings → Client Keys
# 3. Add SENTRY_AUTH_TOKEN from https://sentry.io/settings/auth-tokens/
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
# Release tagging — set this to the git commit SHA in CI
NEXT_PUBLIC_APP_VERSION=

# Google Search Console verification (optional)
# GOOGLE_SITE_VERIFICATION=

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional MET Norway weather. Keep disabled until public contact, shared cache
# migration and distributed rate-limit configuration are verified. No API key.
MET_WEATHER_ENABLED=false
# Owner must supply Faroway identification plus a verified public business contact URL.
MET_USER_AGENT=
