{
  "name": "@faroway/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Faroway web app and API backend",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "vendors:check": "ITINERARY_VENDOR_REQUIRE_ALL=true ITINERARY_VENDOR_TIMEOUT_MS=30000 DUFFEL_SUPPLIER_TIMEOUT_MS=30000 DUFFEL_LINK_TIMEOUT_MS=10000 bun --env-file .env scripts/check-itinerary-vendors.ts",
    "schema:itinerary-streaming": "bun --env-file .env scripts/check-itinerary-streaming-schema.ts",
    "perf:itinerary": "bun --env-file .env scripts/measure-itinerary-stream.ts",
    "clean": "rm -rf .next .turbo"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.29",
    "@anthropic-ai/sdk": "^0.74.0",
    "@faroway/constants": "*",
    "@faroway/supabase": "*",
    "@faroway/types": "*",
    "@hookform/resolvers": "^5.2.2",
    "@sentry/nextjs": "^10.68.0",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "2.110.8",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/typography": "^0.5.19",
    "@types/lodash": "^4.17.23",
    "@vercel/analytics": "^2.0.1",
    "ai": "^6.0.86",
    "amadeus": "^11.0.0",
    "autoprefixer": "^10.4.24",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-geo": "^3.1.1",
    "date-fns": "^4.1.0",
    "gray-matter": "^4.0.3",
    "jose": "5.10.0",
    "leaflet": "^1.9.4",
    "lodash": "4.18.1",
    "lucide-react": "^0.564.0",
    "lz-string": "^1.5.0",
    "nanoid": "^5.1.6",
    "next": "16.2.11",
    "postcss": "8.5.23",
    "qrcode.react": "^4.2.0",
    "react": "19.1.0",
    "react-day-picker": "^9.13.2",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.71.1",
    "react-leaflet": "^5.0.0",
    "react-simple-maps": "^3.0.0",
    "sharp": "0.35.3",
    "tailwind-merge": "^3.4.1",
    "tailwindcss": "^4.1.18",
    "topojson-client": "^3.1.0",
    "workflow": "4.6.2",
    "zod": "^3.25.76",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@faroway/validation": "workspace:*",
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@playwright/test": "^1.49.0",
    "@types/d3-geo": "^3.1.0",
    "@types/geojson": "^7946.0.16",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.5.0",
    "@types/react": "~19.1.10",
    "@types/react-dom": "19.1.0",
    "@types/react-simple-maps": "^3.0.6",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@typescript-eslint/eslint-plugin": "^8.2.0",
    "@typescript-eslint/parser": "^8.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.2.11",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4",
    "vitest": "4.1.10"
  }
}
