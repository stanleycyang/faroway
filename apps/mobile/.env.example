# Supabase Configuration
# Get these from your Supabase project dashboard: https://supabase.com/dashboard

# Public Supabase URL (safe to expose)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/public key (safe to expose, respects RLS)
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Backend API URL
# For local development: http://localhost:3000
# For production: https://your-backend-domain.com
EXPO_PUBLIC_API_URL=http://localhost:3000

# Google Places API Key (optional — enables worldwide city search)
# Get from: https://console.cloud.google.com/apis/credentials
# Enable "Places API" on your GCP project
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=your-google-places-api-key

# Google Sign-In — Web client ID from Google Cloud Console → APIs & Credentials
# This is the **Web** client ID (not Android), required by @react-native-google-signin
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id

# Google Sign-In — iOS OAuth client ID and reversed client ID URL scheme
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=com.googleusercontent.apps.your-ios-client-id

# Itinerary streaming rollout flag (set to false to fall back to polling)
EXPO_PUBLIC_ITINERARY_STREAMING_ENABLED=true

# Error monitoring — Sentry (required for production, see PROD_AUDIT.md P0-2)
# Run: bunx @sentry/wizard@latest -i expo
# EXPO_PUBLIC_SENTRY_DSN=

# EAS Build (optional)
EAS_PROJECT_ID=your-eas-project-id
