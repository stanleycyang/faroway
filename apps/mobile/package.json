{
  "name": "@faroway/mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "clean": "rm -rf .expo .turbo dist",
    "prebuild": "expo prebuild",
    "prebuild:clean": "expo prebuild --clean",
    "e2e:detox:build:ios": "detox build -c ios.sim.debug",
    "e2e:detox:test:ios": "detox test -c ios.sim.debug --record-logs all --take-screenshots failing --cleanup",
    "e2e:detox:test:ios:retry": "detox test -c ios.sim.debug --retries 1 --record-logs failing --take-screenshots failing --cleanup",
    "e2e:maestro:test": "maestro test .maestro",
    "e2e:fixtures:seed": "node ./scripts/e2e/seed-fixtures.mjs",
    "e2e:fixtures:teardown": "node ./scripts/e2e/teardown-fixtures.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@faroway/constants": "*",
    "@faroway/supabase": "*",
    "@faroway/types": "*",
    "@json-render/core": "^0.6.1",
    "@json-render/react-native": "^0.6.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "11.4.1",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@supabase/supabase-js": "^2.94.0",
    "expo": "~54.0.34",
    "expo-apple-authentication": "^8.0.8",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.9",
    "expo-device": "~8.0.10",
    "expo-font": "~14.0.11",
    "expo-haptics": "^15.0.8",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.23",
    "expo-secure-store": "^15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-store-review": "~9.0.9",
    "expo-web-browser": "~15.0.11",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-calendars": "^1.1314.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "^0.21.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.0"
  },
  "expo": {
    "install": {
      "exclude": [
        "jest",
        "@types/jest"
      ]
    }
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@faroway/eslint-config": "*",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.10",
    "detox": "^20.44.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "jest": "^30.2.0",
    "jest-environment-node": "^30.2.0",
    "prettier": "^3.3.3",
    "ts-jest": "^29.4.6",
    "typescript": "~5.9.2"
  },
  "private": true
}
