# Root Environment Variables (Local Supabase CLI & Shared Auth)
# Copy this to .env.local for local Supabase OAuth provider configuration.
#
# App-specific environment templates live in:
#   - apps/web/.env.example    -> copy to apps/web/.env.local
#   - apps/mobile/.env.example -> copy to apps/mobile/.env.local
#
# Run `bun run env:check` from the repo root to validate your local setup.

# ── Local Supabase CLI OAuth (referenced by supabase/config.toml) ──────────────

# Google OAuth (Web client ID & secret from Google Cloud Console -> APIs & Credentials)
SUPABASE_AUTH_GOOGLE_CLIENT_ID=your-google-web-client-id
SUPABASE_AUTH_GOOGLE_SECRET=your-google-web-client-secret

# Apple Sign In (Services ID, e.g. ai.faroway.app.login, and generated client secret JWT)
SUPABASE_AUTH_APPLE_CLIENT_ID=your-apple-services-id
SUPABASE_AUTH_APPLE_SECRET=your-apple-client-secret-jwt
