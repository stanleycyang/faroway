{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noImplicitReturns": true,
    "types": ["node"],
    "lib": ["ES2022", "DOM"],
    "resolveJsonModule": true
  },
  "include": [
    "bun-test.d.ts",
    "uat/**/*.ts",
    "__tests__/uat-staging-guard.test.ts",
    "__tests__/uat-smoke.test.ts",
    "__tests__/model-compare.test.ts",
    "__tests__/agentic-eval.test.ts",
    "__tests__/aggregator-replay.test.ts",
    "__tests__/grounding-evidence.test.ts",
    "__tests__/timing-proposal.test.ts",
    "__tests__/fixed-visit-refinement.test.ts"
  ]
}
