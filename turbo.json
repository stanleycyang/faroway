{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": [
        "VERCEL_ENV",
        "FAROWAY_STAGING_SUPABASE_PROJECT_REF",
        "FAROWAY_PLANNING_PAUSED",
        "FAROWAY_PLAN_EDITING_ENABLED",
        "FAROWAY_BOOKING_CHECKLIST_ENABLED",
        "ACCOUNT_DELETION_ENABLED",
        "PUSH_CONSENT_V2_ENABLED",
        "PUSH_DELIVERY_ENABLED",
        "GOOGLE_PLACES_LIVE_ENABLED",
        "MET_WEATHER_ENABLED",
        "VIATOR_CONTENT_ENABLED",
        "VIATOR_CONTENT_APPROVAL_REF",
        "VIATOR_EXTERNAL_PROCESSING_ENABLED",
        "VIATOR_EXTERNAL_PROCESSING_APPROVAL_REF",
        "VIATOR_HOSTED_CHECKOUT_ENABLED",
        "NEXT_PUBLIC_SUPABASE_URL",
        "NEXT_PUBLIC_SUPABASE_ANON_KEY",
        "NEXT_PUBLIC_APP_URL",
        "NEXT_PUBLIC_BASE_URL",
        "NEXT_PUBLIC_SITE_URL",
        "NEXT_PUBLIC_APP_VERSION",
        "NEXT_PUBLIC_APP_STORE_URL",
        "NEXT_PUBLIC_PLAY_STORE_URL",
        "NEXT_PUBLIC_ITINERARY_STREAMING_ENABLED",
        "NEXT_PUBLIC_SENTRY_DSN",
        "NEXT_PUBLIC_GA_MEASUREMENT_ID",
        "GOOGLE_SITE_VERIFICATION",
        "GOOGLE_PLACES_API_KEY",
        "SUPABASE_SERVICE_ROLE_KEY",
        "AI_GATEWAY_API_KEY",
        "FAROWAY_STAGING_AI_MAX_OUTPUT_TOKENS",
        "ITINERARY_ORCHESTRATOR_TIMEOUT_MS",
        "ITINERARY_AI_AGENT_TIMEOUT_MS",
        "ITINERARY_AGGREGATOR_TIMEOUT_MS",
        "LITEAPI_API_KEY",
        "LITEAPI_SANDBOX_ENABLED",
        "NEXT_PUBLIC_HOTEL_SEARCH_ENABLED",
        "VERCEL_AI_GATEWAY_API_KEY",
        "ANTHROPIC_API_KEY",
        "SENTRY_DSN",
        "SENTRY_AUTH_TOKEN",
        "SENTRY_ORG",
        "SENTRY_PROJECT",
        "ALLOWED_ORIGINS",
        "BASE_URL",
        "CRON_SECRET",
        "IP_HASH_SALT",
        "WORKFLOW_WEBHOOK_SECRET",
        "AMADEUS_CLIENT_ID",
        "AMADEUS_CLIENT_SECRET",
        "AMADEUS_ENV",
        "BOOKING_COM_AFFILIATE_ID",
        "BOOKING_COM_BOOKER_COUNTRY",
        "BOOKING_COM_DEMAND_TOKEN",
        "BOOKING_COM_ENV",
        "BOOKING_COM_PASSWORD",
        "BOOKING_COM_TOKEN",
        "BOOKING_COM_USERNAME",
        "BOOKING_WEBHOOK_SECRET",
        "DUFFEL_API_TOKEN",
        "GETYOURGUIDE_API_KEY",
        "GETYOURGUIDE_PARTNER_ID",
        "GYG_WEBHOOK_SECRET",
        "KLOOK_WEBHOOK_SECRET",
        "RAPIDAPI_KEY",
        "TAVILY_API_KEY",
        "TRIPADVISOR_API_KEY",
        "VIATOR_API_KEY",
        "VIATOR_PARTNER_ID",
        "VIATOR_SANDBOX",
        "VIATOR_WEBHOOK_SECRET"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "type-check": {
      "dependsOn": ["^build"]
    },
    "format": {
      "cache": false
    },
    "format:check": {},
    "test": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "clean": {
      "cache": false
    }
  }
}
