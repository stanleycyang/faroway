{
  "name": "tripgenie",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "clean": "turbo clean",
    "dev:web": "turbo dev --filter=@tripgenie/web",
    "dev:mobile": "turbo dev --filter=@tripgenie/mobile",
    "build:web": "turbo build --filter=@tripgenie/web",
    "build:mobile": "turbo build --filter=@tripgenie/mobile"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.5.4"
  },
  "packageManager": "bun@1.3.9"
}
