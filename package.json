{
  "name": "faroway",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "turbo dev --filter=@faroway/web",
    "dev:mobile": "turbo dev --filter=@faroway/mobile",
    "dev:ios": "turbo dev --filter=@faroway/mobile -- --ios",
    "dev:android": "turbo dev --filter=@faroway/mobile -- --android",
    "build": "turbo build",
    "build:web": "turbo build --filter=@faroway/web",
    "build:mobile": "turbo build --filter=@faroway/mobile",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "format": "turbo format",
    "format:check": "turbo format:check",
    "check": "turbo type-check lint format:check",
    "test": "turbo test && bun run test:scripts",
    "test:scripts": "bun test scripts/__tests__",
    "test:web": "turbo test --filter=@faroway/web",
    "db:start": "bunx supabase start",
    "db:stop": "bunx supabase stop",
    "db:reset": "bunx supabase db reset",
    "db:migrate": "bunx supabase migration up",
    "db:diff": "bunx supabase db diff --schema public",
    "db:push": "bunx supabase db push",
    "db:studio": "open http://localhost:54323",
    "db:status": "bunx supabase status",
    "deploy:web": "vercel --prod",
    "deploy:web:preview": "vercel",
    "deploy:mobile:dev": "cd apps/mobile && eas build --profile development",
    "deploy:mobile:preview": "cd apps/mobile && eas build --profile preview",
    "deploy:mobile:prod": "cd apps/mobile && eas build --profile production",
    "deploy:mobile:submit": "cd apps/mobile && eas submit --profile production",
    "deploy:mobile:update": "cd apps/mobile && eas update",
    "release:check:mobile": "cd apps/mobile && bun run release:check",
    "qa:mobile": "bash scripts/mobile-qa.sh",
    "clean": "turbo clean",
    "clean:all": "turbo clean && rm -rf node_modules apps/*/node_modules packages/*/node_modules",
    "nuke": "turbo clean && rm -rf node_modules apps/*/node_modules packages/*/node_modules bun.lockb && bun install",
    "env:check": "bun run scripts/check-env.ts",
    "preinstall": "node -e \"if(process.env.npm_execpath && !process.env.npm_execpath.includes('bun')) { console.error('\\x1b[31m\\nPlease use bun as the package manager:\\n  bun install\\n\\x1b[0m'); process.exit(1) }\"",
    "dev:mobile:test": "node scripts/mobile-test/run.mjs",
    "test:mobile:integration": "node scripts/mobile-test/verify.mjs",
    "test:mobile:native": "node scripts/mobile-test/native.mjs"
  },
  "overrides": {
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@opentelemetry/core": "2.10.0",
    "@xhmikosr/decompress": "10.2.1",
    "@xmldom/xmldom": "0.8.13",
    "ajv": "6.15.0",
    "d3-color": "3.1.0",
    "defu": "6.1.7",
    "esbuild": "0.28.1",
    "expo-constants": "18.0.14",
    "fast-uri": "3.1.4",
    "file-type": "21.3.4",
    "flatted": "3.4.3",
    "handlebars": "^4.7.10",
    "lodash": "4.18.1",
    "node-forge": "1.4.0",
    "path-to-regexp": "8.4.2",
    "piscina": "^4.9.4",
    "postcss": "8.5.23",
    "qs": "6.15.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "@types/react": "~19.1.10",
    "rollup": "4.62.2",
    "proxy-addr": "^2.0.8",
    "sharp": "^0.35.5",
    "shell-quote": "^1.12.0",
    "tar": "7.5.22",
    "vite": "7.3.6",
    "yaml": "2.9.0",
    "yauzl": "3.4.0"
  },
  "resolutions": {
    "expo-constants": "18.0.14",
    "handlebars": "^4.7.10",
    "piscina": "^4.9.4",
    "proxy-addr": "^2.0.8",
    "sharp": "^0.35.5",
    "shell-quote": "^1.12.0"
  },
  "devDependencies": {
    "@supabase/supabase-js": "2.110.8",
    "gray-matter": "^4.0.3",
    "turbo": "2.10.6",
    "typescript": "^5.5.4"
  },
  "packageManager": "bun@1.3.9"
}
